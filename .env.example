# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored - never commit it. Variables already set in your shell
# take precedence over the values in .env.

# Where the lakehouse lives (catalog + Parquet files). Relative paths are
# resolved against the project root.
DUCKLAKE_DATA_DIR=./data

# Source API for the ingest step.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Uncomment to keep run history in a local Prefect server (see README).
# PREFECT_API_URL=http://127.0.0.1:4200/api

# Future secrets (README exercises 7 and 8) - uncomment when you need them:
# DUCKLAKE_S3_KEY_ID=
# DUCKLAKE_S3_SECRET=
# DUCKLAKE_PG_PASSWORD=
